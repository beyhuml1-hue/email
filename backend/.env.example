# Copy to .env (do not commit the real file).
# Your domain or inbound receiving domain. Example: playermail.example
MAIL_DOMAIN=example.com
# Get these from Resend > API Keys / Webhooks. Never put these in browser code.
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
# Set these when deployed to your HTTPS hostname
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
# Keep on a persistent disk/volume (Railway, VPS, etc.)
DB_PATH=./data/tidalmail.sqlite
